# Local development defaults
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///cathea.db
MEDIA_STORAGE_DIR=static/uploads
MEDIA_STAGING_DIR=instance/media-upload-staging

# Optional server-side import directory
# MEDIA_IMPORT_ROOT=/absolute/path/to/import-folder

# Optional portal host configuration
# PORTAL_HOST=portal.example.com
# PORTAL_SCHEME=https

# Optional Google Calendar integration
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CALENDAR_TOKEN_KEY=
# GOOGLE_CALENDAR_REDIRECT_URI=
# GOOGLE_CALENDAR_ID=primary
